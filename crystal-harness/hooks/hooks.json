{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard-harness-artifacts.sh\"",
            "timeout": 15,
            "statusMessage": "Checking harness artifact ownership"
          }
        ]
      }
    ]
  }
}
